# Conexión a PostgreSQL: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
DATABASE_URL="postgresql://postgres:CAMBIAR@localhost:5432/erp_pollos?schema=public"

# Clave para firmar los tokens JWT (usar una cadena larga y aleatoria)
JWT_SECRET="cambiar-por-una-clave-larga-y-aleatoria"
JWT_EXPIRES_IN="12h"

PORT=3000
# Orígenes permitidos para CORS (panel web), separados por coma
CORS_ORIGINS="http://localhost:5173"

# Margen % por defecto para el precio sugerido de cada lote nuevo
DEFAULT_MARGIN_PERCENT=20

# Zona horaria para agrupar reportes por día
REPORT_TZ="America/La_Paz"

# Freno a intentos fallidos de ingreso: fallos por cuenta y por IP en 15 min (0 = desactivado)
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_IP=20
