// Esquema de la demo del ERP de distribución de pollo.
// Derivado del "Documento de Diseño de Base de Datos v1.0"; las desviaciones
// están explicadas en docs/decisiones-tecnicas.md.
//
// Convenciones de precisión:
//   pesos            Decimal(14, 3)
//   dinero           Decimal(14, 2)
//   costo/precio kg  Decimal(14, 4)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum WarehouseType {
  CENTRAL
  BRANCH
  VEHICLE // almacén móvil: lo cargado en un vehículo durante una ruta
}

enum SaleUnit {
  KG
  CANASTILLO
  UNIDAD
}

enum PurchaseStatus {
  REGISTERED
  RECEIVED
  CANCELLED
}

enum ReceptionStatus {
  COMPLETED
  CANCELLED
}

enum ExpirySource {
  SUPPLIER
  COMPANY
}

enum ShrinkageTreatment {
  ABSORB // la merma se registra como pérdida; el costo por kg no cambia
  INCORPORATE // la merma se reparte en el costo real del kg recibido
}

enum LotStatus {
  ACTIVE
  EXPIRED
  CLOSED
  CANCELLED
}

enum InventoryMovementType {
  PURCHASE
  SALE
  SALE_ANNUL
  TRANSFER_OUT
  TRANSFER_IN
  RETURN
  ADJUSTMENT
  LOSS
}

enum SaleMode {
  CENTRAL
  BRANCH
  PRESALE
}

enum PaymentStatus {
  PAID
  PARTIAL
  CREDIT
  PENDING
}

enum SaleStatus {
  CONFIRMED
  ANNULLED
  RETURNED
}

enum PresaleStatus {
  PENDING // registrada, aún modificable
  CONFIRMED // aceptada por administración
  ASSIGNED // asignada a ruta, ya no modificable
  DELIVERED
  CANCELLED
}

enum ReceivableMovementType {
  CHARGE // venta a crédito (aumenta la deuda)
  PAYMENT // pago del cliente (reduce la deuda)
  ANNUL // reversión por anulación de venta
  RETURN // devolución de productos
  ADJUSTMENT
}

enum PaymentRecordStatus {
  VALID
  ANNULLED
}

enum VisitOutcome {
  ORDER // se tomó pedido
  NO_ORDER // atendió pero no compró
  CLOSED // local cerrado
  NOT_FOUND // no se encontró al responsable
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum SyncStatus {
  PENDING
  SYNCING
  SYNCED
  ERROR
  REVIEW
}

enum TransferStatus {
  IN_TRANSIT // salió del almacén de origen, aún no se recibe
  RECEIVED
  CANCELLED // se canceló en tránsito: el stock vuelve al origen
}

enum AdjustmentKind {
  COUNT // conteo físico: el saldo pasa al peso contado (puede subir o bajar)
  LOSS // baja o pérdida: siempre resta
}

enum AdjustmentReason {
  PHYSICAL_COUNT
  EXPIRED
  DAMAGED
  SPOILED
  THEFT
  OTHER
}

enum RecordStatus {
  VALID
  ANNULLED
}

enum ReturnDisposition {
  RESTOCK // vuelve al stock del mismo lote
  DISCARD // no se puede revender: se registra como pérdida
}

enum RefundMethod {
  CREDIT // se descuenta de la deuda del cliente (o queda como saldo a favor)
  CASH // se devuelve el dinero en caja
}

enum VehicleOwnership {
  OWN
  SUBCONTRACTED
}

enum RouteStatus {
  PLANNED // en armado: se pueden agregar, quitar y ordenar paradas
  IN_PROGRESS // despachada: carga hecha, ruta fija
  COMPLETED // liquidada: sobrantes devueltos al almacén
  CANCELLED
}

enum StopStatus {
  PENDING
  DELIVERED // entregado completo
  PARTIAL // entregado con diferencias
  FAILED // no entregado (con motivo)
}

enum CashAccountType {
  CASH // efectivo físico (caja central, caja de sucursal)
  BANK // cuenta bancaria: QR y transferencias
}

enum CashDirection {
  IN
  OUT
}

enum CashCategory {
  SALE // venta cobrada en mostrador
  COLLECTION // cobro de deuda en oficina
  SETTLEMENT // rendición de un chofer o cobrador
  PURCHASE // pago de una compra
  REFUND // devolución de dinero (devolución o anulación de venta)
  EXPENSE // gasto operativo
  OTHER_INCOME // aporte, capital, otros ingresos
  TRANSFER // traspaso entre cuentas (p. ej. depósito del efectivo al banco)
  ADJUSTMENT // diferencia de arqueo al abrir o cerrar caja
  REVERSAL // reversión por anulación de un cobro, venta o compra
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CrateHolderType {
  WAREHOUSE // almacén central, sucursal o vehículo
  CUSTOMER
  USER // responsable: chofer o cobrador
}

enum CrateMovementType {
  INITIAL // alta de canastillos (compra o inventario inicial)
  DISPATCH // almacén → vehículo al despachar
  DELIVERY // vehículo → cliente
  PICKUP // cliente → vehículo o cobrador
  RETURN // vehículo o responsable → almacén
  SHORTAGE // faltante al liquidar: queda a cargo del chofer
  TRANSFER // movimiento manual entre tenedores
  WRITE_OFF // baja: roto o perdido (con sanción opcional)
}

enum DeliveryProblem {
  CLOSED // local cerrado
  NOT_FOUND // no se encontró al cliente o al responsable
  REJECTED // el cliente rechazó el pedido
  NO_PAYMENT // no tenía con qué pagar
  WRONG_ADDRESS
  DAMAGED // producto dañado en el camino
  NOT_VISITED // no se llegó a visitar
  OTHER
}

// ─────────────────────────────────────────────────────────────
// Seguridad y usuarios
// ─────────────────────────────────────────────────────────────

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  description String?
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique // ej. sales.create, lot.override
  module      String
  description String
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  phone        String?
  email        String?  @unique
  roleId       String   @map("role_id") @db.Uuid
  branchId     String?  @map("branch_id") @db.Uuid // sucursal asignada (vendedor de sucursal)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role   Role    @relation(fields: [roleId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  auditLogs            AuditLog[]
  purchasesCreated     Purchase[]            @relation("PurchaseCreatedBy")
  purchasesAnnulled    Purchase[]            @relation("PurchaseAnnulledBy")
  receptions           Reception[]
  inventoryMovements   InventoryMovement[]
  customersCreated     Customer[]
  addressesCaptured    CustomerAddress[]
  sales                Sale[]                @relation("SaleSeller")
  salesAnnulled        Sale[]                @relation("SaleAnnulledBy")
  lotOverrides         SaleLotAllocation[]
  creditAuthorizations Sale[]                @relation("SaleCreditAuthorizedBy")
  priceAuthorizations  SaleItem[]
  paymentsReceived     Payment[]             @relation("PaymentReceivedBy")
  paymentsAnnulled     Payment[]             @relation("PaymentAnnulledBy")
  receivableMovements  ReceivableMovement[]
  presales             Presale[]
  devices              Device[]
  syncOperations       SyncOperation[]       @relation("SyncOperationUser")
  syncResolutions      SyncOperation[]       @relation("SyncResolvedBy")
  visits               Visit[]
  lotPrices            LotPrice[]
  gpsPositions         GpsPosition[]
  transfersSent        Transfer[]            @relation("TransferSentBy")
  transfersReceived    Transfer[]            @relation("TransferReceivedBy")
  transfersCancelled   Transfer[]            @relation("TransferCancelledBy")
  adjustmentsCreated   InventoryAdjustment[] @relation("AdjustmentCreatedBy")
  adjustmentsAnnulled  InventoryAdjustment[] @relation("AdjustmentAnnulledBy")
  returnsCreated       SaleReturn[]          @relation("ReturnCreatedBy")
  returnsAuthorized    SaleReturn[]          @relation("ReturnAuthorizedBy")
  routesDriven         DeliveryRoute[]       @relation("RouteDriver")
  routesCreated        DeliveryRoute[]       @relation("RouteCreatedBy")
  routesDispatched     DeliveryRoute[]       @relation("RouteDispatchedBy")
  routesClosed         DeliveryRoute[]       @relation("RouteClosedBy")
  routesCancelled      DeliveryRoute[]       @relation("RouteCancelledBy")
  stopsRecorded        RouteStop[]           @relation("StopRecordedBy")
  stopCreditApprovals  RouteStop[]           @relation("StopCreditAuthorizedBy")
  crateMovements       CrateMovement[]
  cashMovements        CashMovement[]
  cashSessionsOpened   CashSession[]         @relation("CashSessionOpenedBy")
  cashSessionsClosed   CashSession[]         @relation("CashSessionClosedBy")
  settlementsGiven     Settlement[]          @relation("SettlementUser")
  settlementsReceived  Settlement[]          @relation("SettlementReceivedBy")
  receiptPrints        ReceiptPrint[]

  @@map("users")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  oldData    Json?    @map("old_data")
  newData    Json?    @map("new_data")
  reason     String?
  deviceId   String?  @map("device_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}

// Numeración visible de documentos (C-000001, V-000001, ...)
model DocumentSequence {
  name      String @id // purchase, sale, presale, lot
  prefix    String
  lastValue Int    @default(0) @map("last_value")

  @@map("document_sequences")
}

// ─────────────────────────────────────────────────────────────
// Organización
// ─────────────────────────────────────────────────────────────

model Branch {
  id                      String   @id @default(uuid()) @db.Uuid
  name                    String
  code                    String   @unique
  address                 String?
  latitude                Decimal? @db.Decimal(10, 7)
  longitude               Decimal? @db.Decimal(10, 7)
  priceEditEnabled        Boolean  @default(false) @map("price_edit_enabled")
  transferWeighingEnabled Boolean  @default(false) @map("transfer_weighing_enabled")
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  warehouses   Warehouse[]
  users        User[]
  sales        Sale[]
  lotPrices    LotPrice[]
  cashAccounts CashAccount[]

  @@map("branches")
}

model Warehouse {
  id        String        @id @default(uuid()) @db.Uuid
  branchId  String?       @map("branch_id") @db.Uuid // null = almacén central
  name      String
  code      String        @unique
  type      WarehouseType
  address   String?
  isActive  Boolean       @default(true) @map("is_active")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  branch             Branch?               @relation(fields: [branchId], references: [id])
  purchases          Purchase[]
  receptions         Reception[]
  lots               Lot[]
  inventoryMovements InventoryMovement[]
  inventoryBalances  InventoryBalance[]
  sales              Sale[]
  transfersOut       Transfer[]            @relation("TransferOrigin")
  transfersIn        Transfer[]            @relation("TransferDestination")
  adjustments        InventoryAdjustment[]
  returns            SaleReturn[]
  vehicle            Vehicle?
  routesFrom         DeliveryRoute[]

  @@map("warehouses")
}

// ─────────────────────────────────────────────────────────────
// Productos y precios
// ─────────────────────────────────────────────────────────────

model ProductCategory {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  code        String    @unique
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  products    Product[]

  @@map("product_categories")
}

model Product {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique
  name       String
  brand      String?
  categoryId String   @map("category_id") @db.Uuid
  saleUnit   SaleUnit @default(KG) @map("sale_unit")
  kgPerCrate Decimal? @map("kg_per_crate") @db.Decimal(8, 3) // si tiene valor, se vende también por canastillo (peso aproximado de uno lleno)
  minStockKg Decimal  @default(0) @map("min_stock_kg") @db.Decimal(14, 3) // alerta de stock bajo (0 = sin alerta)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  category           ProductCategory       @relation(fields: [categoryId], references: [id])
  purchaseItems      PurchaseItem[]
  receptionItems     ReceptionItem[]
  lots               Lot[]
  inventoryMovements InventoryMovement[]
  inventoryBalances  InventoryBalance[]
  saleItems          SaleItem[]
  presaleItems       PresaleItem[]
  transferItems      TransferItem[]
  adjustments        InventoryAdjustment[]
  returnItems        SaleReturnItem[]
  routeStopItems     RouteStopItem[]

  @@map("products")
}

// Precio sugerido por lote (y opcionalmente por sucursal; null = central)
model LotPrice {
  id               String    @id @default(uuid()) @db.Uuid
  lotId            String    @map("lot_id") @db.Uuid
  branchId         String?   @map("branch_id") @db.Uuid
  pricePerKg       Decimal   @map("price_per_kg") @db.Decimal(14, 4)
  marginPercentage Decimal   @map("margin_percentage") @db.Decimal(6, 2)
  validFrom        DateTime  @default(now()) @map("valid_from")
  validTo          DateTime? @map("valid_to")
  isActive         Boolean   @default(true) @map("is_active")
  createdById      String    @map("created_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")

  lot       Lot     @relation(fields: [lotId], references: [id])
  branch    Branch? @relation(fields: [branchId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([lotId, branchId, isActive])
  @@map("lot_prices")
}

// ─────────────────────────────────────────────────────────────
// Compras, recepción y lotes
// ─────────────────────────────────────────────────────────────

model Supplier {
  id          String     @id @default(uuid()) @db.Uuid
  name        String
  taxId       String?    @map("tax_id")
  phone       String?
  address     String?
  contactName String?    @map("contact_name")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  purchases   Purchase[]

  @@map("suppliers")
}

model Purchase {
  id             String         @id @default(uuid()) @db.Uuid
  purchaseNumber String         @unique @map("purchase_number")
  supplierId     String         @map("supplier_id") @db.Uuid
  warehouseId    String         @map("warehouse_id") @db.Uuid
  purchaseDate   DateTime       @map("purchase_date")
  paymentMethod  String         @map("payment_method") // un solo método por compra
  totalAmount    Decimal        @map("total_amount") @db.Decimal(14, 2)
  currency       String         @default("BOB")
  status         PurchaseStatus @default(REGISTERED)
  notes          String?
  createdById    String         @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")
  annulledAt     DateTime?      @map("annulled_at")
  annulledById   String?        @map("annulled_by_id") @db.Uuid
  annulReason    String?        @map("annul_reason")
  paidAt         DateTime?      @map("paid_at") // pagada (al registrarla, o después si fue a crédito del proveedor)
  paidById       String?        @map("paid_by_id") @db.Uuid

  supplier   Supplier       @relation(fields: [supplierId], references: [id])
  warehouse  Warehouse      @relation(fields: [warehouseId], references: [id])
  createdBy  User           @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  annulledBy User?          @relation("PurchaseAnnulledBy", fields: [annulledById], references: [id])
  items      PurchaseItem[]
  receptions Reception[]
  lots       Lot[]

  @@index([supplierId, purchaseDate])
  @@map("purchases")
}

model PurchaseItem {
  id                String  @id @default(uuid()) @db.Uuid
  purchaseId        String  @map("purchase_id") @db.Uuid
  productId         String  @map("product_id") @db.Uuid
  purchasedQuantity Decimal @default(0) @map("purchased_quantity") @db.Decimal(14, 3) // unidades (pollos)
  purchasedWeightKg Decimal @map("purchased_weight_kg") @db.Decimal(14, 3)
  unitCost          Decimal @map("unit_cost") @db.Decimal(14, 4) // costo por kg comprado
  subtotal          Decimal @db.Decimal(14, 2)

  purchase      Purchase       @relation(fields: [purchaseId], references: [id])
  product       Product        @relation(fields: [productId], references: [id])
  receptionItem ReceptionItem?

  @@map("purchase_items")
}

model Reception {
  id           String          @id @default(uuid()) @db.Uuid
  purchaseId   String          @map("purchase_id") @db.Uuid
  warehouseId  String          @map("warehouse_id") @db.Uuid
  receivedAt   DateTime        @map("received_at")
  receivedById String          @map("received_by_id") @db.Uuid
  status       ReceptionStatus @default(COMPLETED)
  notes        String?
  createdAt    DateTime        @default(now()) @map("created_at")

  purchase   Purchase        @relation(fields: [purchaseId], references: [id])
  warehouse  Warehouse       @relation(fields: [warehouseId], references: [id])
  receivedBy User            @relation(fields: [receivedById], references: [id])
  items      ReceptionItem[]
  lots       Lot[]

  @@map("receptions")
}

model ReceptionItem {
  id                  String       @id @default(uuid()) @db.Uuid
  receptionId         String       @map("reception_id") @db.Uuid
  purchaseItemId      String       @unique @map("purchase_item_id") @db.Uuid
  productId           String       @map("product_id") @db.Uuid
  receivedWeightKg    Decimal      @map("received_weight_kg") @db.Decimal(14, 3) // peso bruto en balanza
  receivedQuantity    Decimal      @default(0) @map("received_quantity") @db.Decimal(14, 3)
  canastilloWeightKg  Decimal      @default(0) @map("canastillo_weight_kg") @db.Decimal(14, 3) // tara
  netReceivedWeightKg Decimal      @map("net_received_weight_kg") @db.Decimal(14, 3) // bruto - tara
  shrinkageWeightKg   Decimal      @map("shrinkage_weight_kg") @db.Decimal(14, 3) // comprado - neto
  shrinkagePercentage Decimal      @map("shrinkage_percentage") @db.Decimal(6, 2)
  expiryDate          DateTime     @map("expiry_date") @db.Date
  expirySource        ExpirySource @default(SUPPLIER) @map("expiry_source")
  qualityNotes        String?      @map("quality_notes")

  reception    Reception    @relation(fields: [receptionId], references: [id])
  purchaseItem PurchaseItem @relation(fields: [purchaseItemId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])
  lot          Lot?

  @@map("reception_items")
}

model Lot {
  id                  String             @id @default(uuid()) @db.Uuid
  lotCode             String             @unique @map("lot_code")
  productId           String             @map("product_id") @db.Uuid
  purchaseId          String             @map("purchase_id") @db.Uuid
  receptionId         String             @map("reception_id") @db.Uuid
  receptionItemId     String             @unique @map("reception_item_id") @db.Uuid
  warehouseId         String             @map("warehouse_id") @db.Uuid // ubicación inicial
  receivedWeightKg    Decimal            @map("received_weight_kg") @db.Decimal(14, 3) // peso neto que entra a stock
  receivedQuantity    Decimal            @default(0) @map("received_quantity") @db.Decimal(14, 3)
  originalCostTotal   Decimal            @map("original_cost_total") @db.Decimal(14, 2)
  originalCostPerKg   Decimal            @map("original_cost_per_kg") @db.Decimal(14, 4) // costo del kg comprado
  actualCostPerKg     Decimal            @map("actual_cost_per_kg") @db.Decimal(14, 4) // costo usado en rentabilidad
  shrinkageWeightKg   Decimal            @default(0) @map("shrinkage_weight_kg") @db.Decimal(14, 3)
  shrinkageLossAmount Decimal            @default(0) @map("shrinkage_loss_amount") @db.Decimal(14, 2)
  shrinkageTreatment  ShrinkageTreatment @map("shrinkage_treatment")
  expiryDate          DateTime           @map("expiry_date") @db.Date
  status              LotStatus          @default(ACTIVE)
  createdAt           DateTime           @default(now()) @map("created_at")

  product            Product               @relation(fields: [productId], references: [id])
  purchase           Purchase              @relation(fields: [purchaseId], references: [id])
  reception          Reception             @relation(fields: [receptionId], references: [id])
  receptionItem      ReceptionItem         @relation(fields: [receptionItemId], references: [id])
  warehouse          Warehouse             @relation(fields: [warehouseId], references: [id])
  prices             LotPrice[]
  inventoryMovements InventoryMovement[]
  inventoryBalances  InventoryBalance[]
  saleAllocations    SaleLotAllocation[]
  transferItems      TransferItem[]
  adjustments        InventoryAdjustment[]
  returnItems        SaleReturnItem[]

  @@index([productId, expiryDate])
  @@map("lots")
}

// ─────────────────────────────────────────────────────────────
// Inventario
// ─────────────────────────────────────────────────────────────

// Historial oficial (kardex). Cantidades con signo: + entrada, - salida.
model InventoryMovement {
  id            String                @id @default(uuid()) @db.Uuid
  warehouseId   String                @map("warehouse_id") @db.Uuid
  productId     String                @map("product_id") @db.Uuid
  lotId         String                @map("lot_id") @db.Uuid
  movementType  InventoryMovementType @map("movement_type")
  quantity      Decimal               @default(0) @db.Decimal(14, 3)
  weightKg      Decimal               @map("weight_kg") @db.Decimal(14, 3)
  unitCostPerKg Decimal               @map("unit_cost_per_kg") @db.Decimal(14, 4)
  referenceType String                @map("reference_type")
  referenceId   String                @map("reference_id") @db.Uuid
  movementDate  DateTime              @default(now()) @map("movement_date")
  reason        String?
  createdById   String                @map("created_by_id") @db.Uuid

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  lot       Lot       @relation(fields: [lotId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])

  @@index([warehouseId, productId, lotId, movementDate])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

// Saldo materializado por almacén y lote; se actualiza en la misma transacción que el movimiento.
model InventoryBalance {
  id          String   @id @default(uuid()) @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  lotId       String   @map("lot_id") @db.Uuid
  quantity    Decimal  @default(0) @db.Decimal(14, 3)
  weightKg    Decimal  @default(0) @map("weight_kg") @db.Decimal(14, 3)
  updatedAt   DateTime @updatedAt @map("updated_at")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  lot       Lot       @relation(fields: [lotId], references: [id])

  @@unique([warehouseId, lotId])
  @@index([warehouseId, productId])
  @@map("inventory_balances")
}

// ─────────────────────────────────────────────────────────────
// Clientes
// ─────────────────────────────────────────────────────────────

model CustomerType {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  isActive  Boolean    @default(true) @map("is_active")
  customers Customer[]

  @@map("customer_types")
}

model CustomerRank {
  id                 String     @id @default(uuid()) @db.Uuid
  name               String
  code               String     @unique
  discountPercentage Decimal    @default(0) @map("discount_percentage") @db.Decimal(5, 2)
  creditLimit        Decimal    @default(0) @map("credit_limit") @db.Decimal(14, 2)
  minMonthlyPurchase Decimal    @default(0) @map("min_monthly_purchase") @db.Decimal(14, 2) // compra promedio mensual (90 días) para sugerir el ascenso
  maxDaysOverdue     Int        @default(30) @map("max_days_overdue") // deuda más antigua permitida para sugerirlo
  description        String?
  isActive           Boolean    @default(true) @map("is_active")
  customers          Customer[]

  @@map("customer_ranks")
}

model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  code           String         @unique
  name           String
  documentId     String?        @map("document_id") // CI/NIT
  customerTypeId String         @map("customer_type_id") @db.Uuid
  rankId         String?        @map("rank_id") @db.Uuid
  creditEnabled  Boolean        @default(false) @map("credit_enabled")
  creditLimit    Decimal        @default(0) @map("credit_limit") @db.Decimal(14, 2)
  currentDebt    Decimal        @default(0) @map("current_debt") @db.Decimal(14, 2) // saldo materializado
  phone          String?
  status         CustomerStatus @default(ACTIVE)
  createdById    String?        @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  customerType        CustomerType         @relation(fields: [customerTypeId], references: [id])
  rank                CustomerRank?        @relation(fields: [rankId], references: [id])
  createdBy           User?                @relation(fields: [createdById], references: [id])
  addresses           CustomerAddress[]
  sales               Sale[]
  presales            Presale[]
  payments            Payment[]
  receivableMovements ReceivableMovement[]
  visits              Visit[]
  returns             SaleReturn[]
  routeStops          RouteStop[]

  @@map("customers")
}

model CustomerAddress {
  id           String   @id @default(uuid()) @db.Uuid
  customerId   String   @map("customer_id") @db.Uuid
  label        String
  address      String
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  isPrimary    Boolean  @default(false) @map("is_primary")
  source       String   @default("ADMIN") // ADMIN / PRESALE
  capturedById String?  @map("captured_by_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  customer   Customer    @relation(fields: [customerId], references: [id])
  capturedBy User?       @relation(fields: [capturedById], references: [id])
  presales   Presale[]
  routeStops RouteStop[]

  @@map("customer_addresses")
}

// ─────────────────────────────────────────────────────────────
// Ventas y preventas
// ─────────────────────────────────────────────────────────────

model Sale {
  id                    String        @id @default(uuid()) @db.Uuid
  saleNumber            String        @unique @map("sale_number")
  customerId            String?       @map("customer_id") @db.Uuid // null = venta rápida
  warehouseId           String        @map("warehouse_id") @db.Uuid
  branchId              String?       @map("branch_id") @db.Uuid
  sellerId              String        @map("seller_id") @db.Uuid
  saleMode              SaleMode      @map("sale_mode")
  subtotal              Decimal       @db.Decimal(14, 2)
  discountAmount        Decimal       @default(0) @map("discount_amount") @db.Decimal(14, 2)
  totalAmount           Decimal       @map("total_amount") @db.Decimal(14, 2)
  currency              String        @default("BOB")
  paymentStatus         PaymentStatus @map("payment_status")
  paidAmount            Decimal       @default(0) @map("paid_amount") @db.Decimal(14, 2) // pagado al momento de la venta
  creditAmount          Decimal       @default(0) @map("credit_amount") @db.Decimal(14, 2) // saldo cargado a la deuda
  returnedAmount        Decimal       @default(0) @map("returned_amount") @db.Decimal(14, 2) // devuelto al cliente
  status                SaleStatus    @default(CONFIRMED)
  creditAuthorizedById  String?       @map("credit_authorized_by_id") @db.Uuid // excepción al límite de crédito
  creditExceptionReason String?       @map("credit_exception_reason")
  notes                 String?
  createdAt             DateTime      @default(now()) @map("created_at")
  annulledAt            DateTime?     @map("annulled_at")
  annulledById          String?       @map("annulled_by_id") @db.Uuid
  annulReason           String?       @map("annul_reason")

  customer           Customer?    @relation(fields: [customerId], references: [id])
  warehouse          Warehouse    @relation(fields: [warehouseId], references: [id])
  branch             Branch?      @relation(fields: [branchId], references: [id])
  seller             User         @relation("SaleSeller", fields: [sellerId], references: [id])
  annulledBy         User?        @relation("SaleAnnulledBy", fields: [annulledById], references: [id])
  creditAuthorizedBy User?        @relation("SaleCreditAuthorizedBy", fields: [creditAuthorizedById], references: [id])
  items              SaleItem[]
  presale            Presale?
  payments           Payment[]
  returns            SaleReturn[]
  routeStop          RouteStop?

  @@index([customerId, createdAt])
  @@index([createdAt])
  @@map("sales")
}

model SaleItem {
  id                  String  @id @default(uuid()) @db.Uuid
  saleId              String  @map("sale_id") @db.Uuid
  productId           String  @map("product_id") @db.Uuid
  requestedWeightKg   Decimal @map("requested_weight_kg") @db.Decimal(14, 3)
  requestedQuantity   Decimal @default(0) @map("requested_quantity") @db.Decimal(14, 3)
  crates              Int     @default(0) // venta por canastillo: cuántos lleva (el precio sigue siendo por kg)
  originalUnitPrice   Decimal @map("original_unit_price") @db.Decimal(14, 4) // precio sugerido
  unitPrice           Decimal @map("unit_price") @db.Decimal(14, 4) // precio final aplicado
  discountAmount      Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  subtotal            Decimal @db.Decimal(14, 2) // después del descuento
  returnedWeightKg    Decimal @default(0) @map("returned_weight_kg") @db.Decimal(14, 3)
  returnedAmount      Decimal @default(0) @map("returned_amount") @db.Decimal(14, 2)
  priceChangeReason   String? @map("price_change_reason")
  priceAuthorizedById String? @map("price_authorized_by_id") @db.Uuid

  sale              Sale                @relation(fields: [saleId], references: [id])
  product           Product             @relation(fields: [productId], references: [id])
  priceAuthorizedBy User?               @relation(fields: [priceAuthorizedById], references: [id])
  allocations       SaleLotAllocation[]
  returnItems       SaleReturnItem[]

  @@map("sale_items")
}

// Una línea de venta puede consumirse de varios lotes; se congela el costo de cada uno.
model SaleLotAllocation {
  id                String   @id @default(uuid()) @db.Uuid
  saleItemId        String   @map("sale_item_id") @db.Uuid
  lotId             String   @map("lot_id") @db.Uuid
  weightKg          Decimal  @map("weight_kg") @db.Decimal(14, 3)
  quantity          Decimal  @default(0) @db.Decimal(14, 3)
  costPerKg         Decimal  @map("cost_per_kg") @db.Decimal(14, 4)
  salePricePerKg    Decimal  @map("sale_price_per_kg") @db.Decimal(14, 4)
  forcedLot         Boolean  @default(false) @map("forced_lot") // se saltó la prioridad FEFO
  authorizedById    String?  @map("authorized_by_id") @db.Uuid
  forceReason       String?  @map("force_reason")
  returnedWeightKg  Decimal  @default(0) @map("returned_weight_kg") @db.Decimal(14, 3)
  restockedWeightKg Decimal  @default(0) @map("restocked_weight_kg") @db.Decimal(14, 3) // parte devuelta que volvió al stock
  createdAt         DateTime @default(now()) @map("created_at")

  saleItem     SaleItem         @relation(fields: [saleItemId], references: [id])
  lot          Lot              @relation(fields: [lotId], references: [id])
  authorizedBy User?            @relation(fields: [authorizedById], references: [id])
  returnItems  SaleReturnItem[]

  @@index([lotId])
  @@map("sale_lot_allocations")
}

model Presale {
  id                    String        @id @default(uuid()) @db.Uuid
  presaleNumber         String        @unique @map("presale_number")
  customerId            String        @map("customer_id") @db.Uuid
  addressId             String?       @map("address_id") @db.Uuid
  preventistaId         String        @map("preventista_id") @db.Uuid
  status                PresaleStatus @default(PENDING)
  scheduledDeliveryDate DateTime?     @map("scheduled_delivery_date") @db.Date
  totalAmount           Decimal       @map("total_amount") @db.Decimal(14, 2)
  notes                 String?
  createdOffline        Boolean       @default(false) @map("created_offline")
  deviceOperationId     String?       @unique @map("device_operation_id") @db.Uuid
  createdAtDevice       DateTime?     @map("created_at_device")
  saleId                String?       @unique @map("sale_id") @db.Uuid // venta que atendió el pedido
  latitude              Decimal?      @db.Decimal(10, 7) // dónde se tomó el pedido
  longitude             Decimal?      @db.Decimal(10, 7)
  cancelledAt           DateTime?     @map("cancelled_at")
  cancelReason          String?       @map("cancel_reason")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  customer    Customer         @relation(fields: [customerId], references: [id])
  address     CustomerAddress? @relation(fields: [addressId], references: [id])
  preventista User             @relation(fields: [preventistaId], references: [id])
  sale        Sale?            @relation(fields: [saleId], references: [id])
  items       PresaleItem[]
  routeStops  RouteStop[]

  @@index([preventistaId, status, scheduledDeliveryDate])
  @@map("presales")
}

model PresaleItem {
  id        String  @id @default(uuid()) @db.Uuid
  presaleId String  @map("presale_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Decimal @default(0) @db.Decimal(14, 3)
  crates    Int     @default(0) // pedido por canastillo
  weightKg  Decimal @map("weight_kg") @db.Decimal(14, 3)
  unitPrice Decimal @map("unit_price") @db.Decimal(14, 4)
  subtotal  Decimal @db.Decimal(14, 2)
  notes     String?

  presale Presale @relation(fields: [presaleId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("presale_items")
}

// ─────────────────────────────────────────────────────────────
// Pagos y cuentas por cobrar (mínimo para ventas a crédito)
// ─────────────────────────────────────────────────────────────

// Un pago tiene un solo método; un pago combinado se registra como varios pagos.
model Payment {
  id                String              @id @default(uuid()) @db.Uuid
  customerId        String?             @map("customer_id") @db.Uuid
  saleId            String?             @map("sale_id") @db.Uuid
  amount            Decimal             @db.Decimal(14, 2)
  paymentMethod     String              @map("payment_method")
  paymentSource     String              @default("CENTRAL") @map("payment_source") // CENTRAL/BRANCH/DRIVER/COLLECTOR
  receivedById      String              @map("received_by_id") @db.Uuid
  paymentDate       DateTime            @default(now()) @map("payment_date")
  referenceNumber   String?             @map("reference_number")
  notes             String?
  // Cobros de deuda (sin venta asociada): número de recibo visible y anulación con motivo.
  receiptNumber     String?             @unique @map("receipt_number")
  isAdvance         Boolean             @default(false) @map("is_advance") // dejó saldo a favor
  status            PaymentRecordStatus @default(VALID)
  annulledAt        DateTime?           @map("annulled_at")
  annulledById      String?             @map("annulled_by_id") @db.Uuid
  annulReason       String?             @map("annul_reason")
  // Cobro en la calle (app del cobrador): quién entregó el dinero, su firma, dónde y cuándo según el teléfono.
  paidByName        String?             @map("paid_by_name")
  signature         String?
  latitude          Decimal?            @db.Decimal(10, 7)
  longitude         Decimal?            @db.Decimal(10, 7)
  collectedAtDevice DateTime?           @map("collected_at_device")
  deviceOperationId String?             @unique @map("device_operation_id") @db.Uuid
  settlementId      String?             @map("settlement_id") @db.Uuid // rendición en la que el chofer o cobrador entregó este dinero

  settlement Settlement? @relation(fields: [settlementId], references: [id])
  customer   Customer?   @relation(fields: [customerId], references: [id])
  sale       Sale?       @relation(fields: [saleId], references: [id])
  receivedBy User        @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  annulledBy User?       @relation("PaymentAnnulledBy", fields: [annulledById], references: [id])

  @@index([customerId, paymentDate])
  @@map("payments")
}

// Historial de la deuda: customers.current_debt es la suma de estos movimientos.
model ReceivableMovement {
  id            String                 @id @default(uuid()) @db.Uuid
  customerId    String                 @map("customer_id") @db.Uuid
  movementType  ReceivableMovementType @map("movement_type")
  amount        Decimal                @db.Decimal(14, 2) // + aumenta la deuda, − la reduce
  balanceAfter  Decimal                @map("balance_after") @db.Decimal(14, 2)
  referenceType String                 @map("reference_type")
  referenceId   String                 @map("reference_id") @db.Uuid
  reason        String?
  createdById   String                 @map("created_by_id") @db.Uuid
  createdAt     DateTime               @default(now()) @map("created_at")

  customer  Customer @relation(fields: [customerId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([customerId, createdAt])
  @@map("receivable_movements")
}

// ─────────────────────────────────────────────────────────────
// Dispositivos y sincronización offline
// ─────────────────────────────────────────────────────────────

model Device {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  deviceUuid     String          @unique @map("device_uuid")
  platform       String
  appVersion     String?         @map("app_version")
  lastSyncAt     DateTime?       @map("last_sync_at")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  user           User            @relation(fields: [userId], references: [id])
  syncOperations SyncOperation[]
  gpsPositions   GpsPosition[]

  @@map("devices")
}

model SyncOperation {
  id                String     @id @default(uuid()) @db.Uuid
  deviceOperationId String     @unique @map("device_operation_id") @db.Uuid // generado en el móvil
  deviceId          String     @map("device_id") @db.Uuid
  userId            String     @map("user_id") @db.Uuid
  operationType     String     @map("operation_type")
  entityType        String     @map("entity_type")
  entityId          String?    @map("entity_id") @db.Uuid
  payload           Json
  status            SyncStatus @default(PENDING)
  createdAtDevice   DateTime   @map("created_at_device")
  receivedAtServer  DateTime   @default(now()) @map("received_at_server")
  errorMessage      String?    @map("error_message")
  // Revisión administrativa de operaciones rechazadas (conflictos que no se resuelven solos).
  resolvedAt        DateTime?  @map("resolved_at")
  resolvedById      String?    @map("resolved_by_id") @db.Uuid
  resolutionNote    String?    @map("resolution_note")

  device     Device @relation(fields: [deviceId], references: [id])
  user       User   @relation("SyncOperationUser", fields: [userId], references: [id])
  resolvedBy User?  @relation("SyncResolvedBy", fields: [resolvedById], references: [id])

  @@index([status, resolvedAt])
  @@map("sync_operations")
}

// Visita del preventista a un cliente, con o sin pedido (registro de visitas del alcance §6.4).
model Visit {
  id              String       @id @db.Uuid // generado en el móvil
  preventistaId   String       @map("preventista_id") @db.Uuid
  customerId      String       @map("customer_id") @db.Uuid
  outcome         VisitOutcome
  notes           String?
  presaleId       String?      @map("presale_id") @db.Uuid
  latitude        Decimal?     @db.Decimal(10, 7)
  longitude       Decimal?     @db.Decimal(10, 7)
  visitedAtDevice DateTime     @map("visited_at_device")
  createdAt       DateTime     @default(now()) @map("created_at")

  preventista User     @relation(fields: [preventistaId], references: [id])
  customer    Customer @relation(fields: [customerId], references: [id])

  @@index([preventistaId, visitedAtDevice])
  @@map("visits")
}

// GPS del teléfono: por evento (pedido, alta de cliente) o periódico (~10 min). No es GPS vehicular.
model GpsPosition {
  id               String   @id @default(uuid()) @db.Uuid
  deviceId         String   @map("device_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  latitude         Decimal  @db.Decimal(10, 7)
  longitude        Decimal  @db.Decimal(10, 7)
  accuracyMeters   Decimal? @map("accuracy_meters") @db.Decimal(8, 2)
  eventType        String   @map("event_type") // PERIODIC / PRESALE / CUSTOMER_CREATE / VISIT
  referenceId      String?  @map("reference_id") @db.Uuid
  capturedAtDevice DateTime @map("captured_at_device")
  receivedAtServer DateTime @default(now()) @map("received_at_server")

  device Device @relation(fields: [deviceId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, capturedAtDevice])
  @@map("gps_positions")
}

// ─────────────────────────────────────────────────────────────
// Inventario operativo: transferencias, ajustes y bajas, devoluciones
// ─────────────────────────────────────────────────────────────

model Transfer {
  id                     String         @id @default(uuid()) @db.Uuid
  transferNumber         String         @unique @map("transfer_number")
  originWarehouseId      String         @map("origin_warehouse_id") @db.Uuid
  destinationWarehouseId String         @map("destination_warehouse_id") @db.Uuid
  status                 TransferStatus @default(IN_TRANSIT)
  notes                  String?
  sentById               String         @map("sent_by_id") @db.Uuid
  sentAt                 DateTime       @default(now()) @map("sent_at")
  receivedById           String?        @map("received_by_id") @db.Uuid
  receivedAt             DateTime?      @map("received_at")
  receiveNotes           String?        @map("receive_notes")
  cancelledById          String?        @map("cancelled_by_id") @db.Uuid
  cancelledAt            DateTime?      @map("cancelled_at")
  cancelReason           String?        @map("cancel_reason")

  origin      Warehouse      @relation("TransferOrigin", fields: [originWarehouseId], references: [id])
  destination Warehouse      @relation("TransferDestination", fields: [destinationWarehouseId], references: [id])
  sentBy      User           @relation("TransferSentBy", fields: [sentById], references: [id])
  receivedBy  User?          @relation("TransferReceivedBy", fields: [receivedById], references: [id])
  cancelledBy User?          @relation("TransferCancelledBy", fields: [cancelledById], references: [id])
  items       TransferItem[]
  routeLoad   DeliveryRoute? @relation("RouteLoadTransfer")
  routeReturn DeliveryRoute? @relation("RouteReturnTransfer")

  @@index([status, sentAt])
  @@map("transfers")
}

model TransferItem {
  id               String   @id @default(uuid()) @db.Uuid
  transferId       String   @map("transfer_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  lotId            String   @map("lot_id") @db.Uuid
  sentWeightKg     Decimal  @map("sent_weight_kg") @db.Decimal(14, 3)
  sentQuantity     Decimal  @default(0) @map("sent_quantity") @db.Decimal(14, 3)
  receivedWeightKg Decimal? @map("received_weight_kg") @db.Decimal(14, 3)
  receivedQuantity Decimal? @map("received_quantity") @db.Decimal(14, 3)
  differenceKg     Decimal  @default(0) @map("difference_kg") @db.Decimal(14, 3) // enviado − recibido (pérdida en tránsito)
  costPerKg        Decimal  @map("cost_per_kg") @db.Decimal(14, 4)
  lossAmount       Decimal  @default(0) @map("loss_amount") @db.Decimal(14, 2)

  transfer Transfer @relation(fields: [transferId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])
  lot      Lot      @relation(fields: [lotId], references: [id])

  @@map("transfer_items")
}

model InventoryAdjustment {
  id               String           @id @default(uuid()) @db.Uuid
  adjustmentNumber String           @unique @map("adjustment_number")
  kind             AdjustmentKind
  reasonCode       AdjustmentReason @map("reason_code")
  warehouseId      String           @map("warehouse_id") @db.Uuid
  productId        String           @map("product_id") @db.Uuid
  lotId            String           @map("lot_id") @db.Uuid
  systemWeightKg   Decimal          @map("system_weight_kg") @db.Decimal(14, 3) // saldo antes del ajuste
  newWeightKg      Decimal          @map("new_weight_kg") @db.Decimal(14, 3) // saldo después
  weightKg         Decimal          @map("weight_kg") @db.Decimal(14, 3) // diferencia con signo
  quantity         Decimal          @default(0) @db.Decimal(14, 3) // diferencia en unidades, con signo
  costPerKg        Decimal          @map("cost_per_kg") @db.Decimal(14, 4)
  amount           Decimal          @db.Decimal(14, 2) // valor de la diferencia, con signo (negativo = pérdida)
  notes            String
  status           RecordStatus     @default(VALID)
  createdById      String           @map("created_by_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at")
  annulledById     String?          @map("annulled_by_id") @db.Uuid
  annulledAt       DateTime?        @map("annulled_at")
  annulReason      String?          @map("annul_reason")

  warehouse  Warehouse @relation(fields: [warehouseId], references: [id])
  product    Product   @relation(fields: [productId], references: [id])
  lot        Lot       @relation(fields: [lotId], references: [id])
  createdBy  User      @relation("AdjustmentCreatedBy", fields: [createdById], references: [id])
  annulledBy User?     @relation("AdjustmentAnnulledBy", fields: [annulledById], references: [id])

  @@index([createdAt])
  @@map("inventory_adjustments")
}

model SaleReturn {
  id             String       @id @default(uuid()) @db.Uuid
  returnNumber   String       @unique @map("return_number")
  saleId         String       @map("sale_id") @db.Uuid
  customerId     String?      @map("customer_id") @db.Uuid
  warehouseId    String       @map("warehouse_id") @db.Uuid
  reason         String
  refundMethod   RefundMethod @map("refund_method")
  totalAmount    Decimal      @map("total_amount") @db.Decimal(14, 2)
  restockedKg    Decimal      @default(0) @map("restocked_kg") @db.Decimal(14, 3)
  discardedKg    Decimal      @default(0) @map("discarded_kg") @db.Decimal(14, 3)
  lossAmount     Decimal      @default(0) @map("loss_amount") @db.Decimal(14, 2) // costo de lo descartado
  authorizedById String       @map("authorized_by_id") @db.Uuid
  createdById    String       @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")

  sale         Sale             @relation(fields: [saleId], references: [id])
  customer     Customer?        @relation(fields: [customerId], references: [id])
  warehouse    Warehouse        @relation(fields: [warehouseId], references: [id])
  authorizedBy User             @relation("ReturnAuthorizedBy", fields: [authorizedById], references: [id])
  createdBy    User             @relation("ReturnCreatedBy", fields: [createdById], references: [id])
  items        SaleReturnItem[]

  @@index([createdAt])
  @@map("sale_returns")
}

model SaleReturnItem {
  id           String            @id @default(uuid()) @db.Uuid
  returnId     String            @map("return_id") @db.Uuid
  saleItemId   String            @map("sale_item_id") @db.Uuid
  allocationId String            @map("allocation_id") @db.Uuid
  productId    String            @map("product_id") @db.Uuid
  lotId        String            @map("lot_id") @db.Uuid
  weightKg     Decimal           @map("weight_kg") @db.Decimal(14, 3)
  amount       Decimal           @db.Decimal(14, 2)
  costPerKg    Decimal           @map("cost_per_kg") @db.Decimal(14, 4)
  disposition  ReturnDisposition

  saleReturn SaleReturn        @relation(fields: [returnId], references: [id])
  saleItem   SaleItem          @relation(fields: [saleItemId], references: [id])
  allocation SaleLotAllocation @relation(fields: [allocationId], references: [id])
  product    Product           @relation(fields: [productId], references: [id])
  lot        Lot               @relation(fields: [lotId], references: [id])

  @@map("sale_return_items")
}

// ─────────────────────────────────────────────────────────────
// Logística: vehículos, rutas y entregas
// ─────────────────────────────────────────────────────────────

model Vehicle {
  id             String           @id @default(uuid()) @db.Uuid
  plate          String           @unique
  description    String
  ownership      VehicleOwnership
  ownerName      String?          @map("owner_name") // empresa o dueño si es subcontratado
  capacityKg     Decimal          @map("capacity_kg") @db.Decimal(14, 3)
  capacityCrates Int              @map("capacity_crates")
  warehouseId    String           @unique @map("warehouse_id") @db.Uuid // almacén móvil del vehículo
  isActive       Boolean          @default(true) @map("is_active")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])
  routes    DeliveryRoute[]

  @@map("vehicles")
}

model DeliveryRoute {
  id                String      @id @default(uuid()) @db.Uuid
  routeNumber       String      @unique @map("route_number")
  routeDate         DateTime    @map("route_date") @db.Date
  vehicleId         String      @map("vehicle_id") @db.Uuid
  driverId          String      @map("driver_id") @db.Uuid
  originWarehouseId String      @map("origin_warehouse_id") @db.Uuid
  status            RouteStatus @default(PLANNED)
  notes             String?
  loadTransferId    String?     @unique @map("load_transfer_id") @db.Uuid // carga: origen → vehículo
  returnTransferId  String?     @unique @map("return_transfer_id") @db.Uuid // sobrantes: vehículo → origen
  createdById       String      @map("created_by_id") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at")
  dispatchedById    String?     @map("dispatched_by_id") @db.Uuid
  dispatchedAt      DateTime?   @map("dispatched_at")
  closedById        String?     @map("closed_by_id") @db.Uuid
  closedAt          DateTime?   @map("closed_at")
  closeNotes        String?     @map("close_notes")
  cratesLoaded      Int         @default(0) @map("crates_loaded") // canastillos que salen en el vehículo
  cratesReturned    Int?        @map("crates_returned") // contados al liquidar
  cancelledById     String?     @map("cancelled_by_id") @db.Uuid
  cancelledAt       DateTime?   @map("cancelled_at")
  cancelReason      String?     @map("cancel_reason")

  vehicle         Vehicle     @relation(fields: [vehicleId], references: [id])
  driver          User        @relation("RouteDriver", fields: [driverId], references: [id])
  originWarehouse Warehouse   @relation(fields: [originWarehouseId], references: [id])
  createdBy       User        @relation("RouteCreatedBy", fields: [createdById], references: [id])
  dispatchedBy    User?       @relation("RouteDispatchedBy", fields: [dispatchedById], references: [id])
  closedBy        User?       @relation("RouteClosedBy", fields: [closedById], references: [id])
  cancelledBy     User?       @relation("RouteCancelledBy", fields: [cancelledById], references: [id])
  loadTransfer    Transfer?   @relation("RouteLoadTransfer", fields: [loadTransferId], references: [id])
  returnTransfer  Transfer?   @relation("RouteReturnTransfer", fields: [returnTransferId], references: [id])
  stops           RouteStop[]

  @@index([routeDate, status])
  @@index([driverId, status])
  @@map("delivery_routes")
}

model RouteStop {
  id                   String           @id @default(uuid()) @db.Uuid
  routeId              String           @map("route_id") @db.Uuid
  sequence             Int
  presaleId            String           @map("presale_id") @db.Uuid
  customerId           String           @map("customer_id") @db.Uuid
  addressId            String?          @map("address_id") @db.Uuid
  status               StopStatus       @default(PENDING)
  // Excepción de crédito autorizada al planificar (el chofer no puede pedirla en la calle).
  creditAuthorizedById String?          @map("credit_authorized_by_id") @db.Uuid
  creditAuthReason     String?          @map("credit_auth_reason")
  saleId               String?          @unique @map("sale_id") @db.Uuid
  receivedByName       String?          @map("received_by_name")
  signature            String? // imagen PNG de la firma (data URL)
  paidAmount           Decimal          @default(0) @map("paid_amount") @db.Decimal(14, 2)
  paymentMethod        String?          @map("payment_method")
  problemType          DeliveryProblem? @map("problem_type")
  cratesDelivered      Int              @default(0) @map("crates_delivered") // canastillos que quedan con el cliente
  cratesPickedUp       Int              @default(0) @map("crates_picked_up") // vacíos que el cliente devuelve
  notes                String?
  latitude             Decimal?         @db.Decimal(10, 7)
  longitude            Decimal?         @db.Decimal(10, 7)
  resolvedAtDevice     DateTime?        @map("resolved_at_device")
  resolvedAt           DateTime?        @map("resolved_at")
  recordedById         String?          @map("recorded_by_id") @db.Uuid
  deviceOperationId    String?          @unique @map("device_operation_id") @db.Uuid

  route              DeliveryRoute    @relation(fields: [routeId], references: [id])
  presale            Presale          @relation(fields: [presaleId], references: [id])
  customer           Customer         @relation(fields: [customerId], references: [id])
  address            CustomerAddress? @relation(fields: [addressId], references: [id])
  sale               Sale?            @relation(fields: [saleId], references: [id])
  creditAuthorizedBy User?            @relation("StopCreditAuthorizedBy", fields: [creditAuthorizedById], references: [id])
  recordedBy         User?            @relation("StopRecordedBy", fields: [recordedById], references: [id])
  items              RouteStopItem[]

  @@index([routeId, sequence])
  @@index([presaleId])
  @@map("route_stops")
}

model RouteStopItem {
  id                String   @id @default(uuid()) @db.Uuid
  stopId            String   @map("stop_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  orderedWeightKg   Decimal  @map("ordered_weight_kg") @db.Decimal(14, 3)
  orderedQuantity   Decimal  @default(0) @map("ordered_quantity") @db.Decimal(14, 3)
  orderedCrates     Int      @default(0) @map("ordered_crates")
  deliveredWeightKg Decimal? @map("delivered_weight_kg") @db.Decimal(14, 3)
  differenceReason  String?  @map("difference_reason")

  stop    RouteStop @relation(fields: [stopId], references: [id])
  product Product   @relation(fields: [productId], references: [id])

  @@map("route_stop_items")
}

// ─────────────────────────────────────────────────────────────
// Canastillos: control por cantidad y por responsable
// ─────────────────────────────────────────────────────────────

/**
 * Saldo de canastillos de cada tenedor; siempre igual a la suma de sus movimientos.
 */
model CrateBalance {
  holderType CrateHolderType @map("holder_type")
  holderId   String          @map("holder_id") @db.Uuid
  quantity   Int             @default(0)
  updatedAt  DateTime        @updatedAt @map("updated_at")

  @@id([holderType, holderId])
  @@map("crate_balances")
}

model CrateMovement {
  id            String            @id @default(uuid()) @db.Uuid
  type          CrateMovementType
  quantity      Int
  fromType      CrateHolderType?  @map("from_type")
  fromId        String?           @map("from_id") @db.Uuid
  toType        CrateHolderType?  @map("to_type")
  toId          String?           @map("to_id") @db.Uuid
  referenceType String?           @map("reference_type")
  referenceId   String?           @map("reference_id") @db.Uuid
  reason        String?
  chargeAmount  Decimal?          @map("charge_amount") @db.Decimal(14, 2) // sanción cobrada al cliente
  createdById   String            @map("created_by_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at")

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([fromType, fromId])
  @@index([toType, toId])
  @@index([createdAt])
  @@map("crate_movements")
}

// ─────────────────────────────────────────────────────────────
// Finanzas operativas: cuentas de dinero, cajas, movimientos y rendiciones
// ─────────────────────────────────────────────────────────────

model CashAccount {
  id        String          @id @default(uuid()) @db.Uuid
  code      String          @unique
  name      String
  type      CashAccountType
  branchId  String?         @map("branch_id") @db.Uuid
  balance   Decimal         @default(0) @db.Decimal(14, 2) // siempre igual a la suma de sus movimientos
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")

  branch      Branch?        @relation(fields: [branchId], references: [id])
  movements   CashMovement[]
  sessions    CashSession[]
  settlements Settlement[]

  @@map("cash_accounts")
}

/**
 * Apertura y cierre de una caja de efectivo, con el arqueo de cada momento.
 */
model CashSession {
  id                String            @id @default(uuid()) @db.Uuid
  sessionNumber     String            @unique @map("session_number")
  cashAccountId     String            @map("cash_account_id") @db.Uuid
  status            CashSessionStatus @default(OPEN)
  openedById        String            @map("opened_by_id") @db.Uuid
  openedAt          DateTime          @default(now()) @map("opened_at")
  openingExpected   Decimal           @map("opening_expected") @db.Decimal(14, 2)
  openingCounted    Decimal           @map("opening_counted") @db.Decimal(14, 2)
  closedById        String?           @map("closed_by_id") @db.Uuid
  closedAt          DateTime?         @map("closed_at")
  closingExpected   Decimal?          @map("closing_expected") @db.Decimal(14, 2)
  closingCounted    Decimal?          @map("closing_counted") @db.Decimal(14, 2)
  closingDifference Decimal?          @map("closing_difference") @db.Decimal(14, 2)
  denominations     Json? // conteo por billete y moneda
  notes             String?

  cashAccount CashAccount    @relation(fields: [cashAccountId], references: [id])
  openedBy    User           @relation("CashSessionOpenedBy", fields: [openedById], references: [id])
  closedBy    User?          @relation("CashSessionClosedBy", fields: [closedById], references: [id])
  movements   CashMovement[]

  @@index([cashAccountId, status])
  @@map("cash_sessions")
}

model CashMovement {
  id            String        @id @default(uuid()) @db.Uuid
  cashAccountId String        @map("cash_account_id") @db.Uuid
  sessionId     String?       @map("session_id") @db.Uuid
  direction     CashDirection
  category      CashCategory
  expenseType   String?       @map("expense_type") // combustible, sueldos, alquiler…
  amount        Decimal       @db.Decimal(14, 2) // siempre positivo; el sentido lo da direction
  balanceAfter  Decimal       @map("balance_after") @db.Decimal(14, 2)
  paymentMethod String?       @map("payment_method")
  description   String
  referenceType String?       @map("reference_type")
  referenceId   String?       @map("reference_id") @db.Uuid
  reversedById  String?       @unique @map("reversed_by_id") @db.Uuid // movimiento que lo revirtió
  createdById   String        @map("created_by_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")

  cashAccount CashAccount  @relation(fields: [cashAccountId], references: [id])
  session     CashSession? @relation(fields: [sessionId], references: [id])
  createdBy   User         @relation(fields: [createdById], references: [id])

  @@index([cashAccountId, createdAt])
  @@index([referenceType, referenceId])
  @@index([category, createdAt])
  @@map("cash_movements")
}

/**
 * Rendición: el chofer o el cobrador entrega lo que cobró; se compara lo esperado con lo contado.
 */
model Settlement {
  id               String   @id @default(uuid()) @db.Uuid
  settlementNumber String   @unique @map("settlement_number")
  userId           String   @map("user_id") @db.Uuid
  cashAccountId    String   @map("cash_account_id") @db.Uuid
  receivedById     String   @map("received_by_id") @db.Uuid
  expectedCash     Decimal  @map("expected_cash") @db.Decimal(14, 2)
  countedCash      Decimal  @map("counted_cash") @db.Decimal(14, 2)
  cashDifference   Decimal  @map("cash_difference") @db.Decimal(14, 2) // contado − esperado (negativo = faltante)
  digitalAmount    Decimal  @map("digital_amount") @db.Decimal(14, 2) // QR y transferencias, ya en el banco
  paymentsCount    Int      @map("payments_count")
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")

  user        User        @relation("SettlementUser", fields: [userId], references: [id])
  receivedBy  User        @relation("SettlementReceivedBy", fields: [receivedById], references: [id])
  cashAccount CashAccount @relation(fields: [cashAccountId], references: [id])
  payments    Payment[]

  @@index([userId, createdAt])
  @@map("settlements")
}

// ─────────────────────────────────────────────────────────────
// Recibos: datos del negocio e historial de impresiones
// ─────────────────────────────────────────────────────────────

/**
 * Configuración simple clave/valor (datos del negocio para los recibos).
 */
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

/**
 * Cada impresión de un comprobante: la primera es el original; las siguientes, copias numeradas.
 */
model ReceiptPrint {
  id             String   @id @default(uuid()) @db.Uuid
  documentType   String   @map("document_type") // SALE, DELIVERY, COLLECTION, SETTLEMENT, CASH_SESSION
  documentId     String   @map("document_id") @db.Uuid
  documentNumber String   @map("document_number")
  copyNumber     Int      @map("copy_number") // 0 = original
  channel        String // WEB, BLUETOOTH
  printedById    String   @map("printed_by_id") @db.Uuid
  printedAt      DateTime @default(now()) @map("printed_at")

  printedBy User @relation(fields: [printedById], references: [id])

  @@index([documentType, documentId])
  @@index([printedAt])
  @@map("receipt_prints")
}
