# Copiar a .env en el servidor y completar. Nunca subir .env al repositorio.

# Dominio público (con su registro DNS apuntando a la IP del servidor). Caddy obtiene HTTPS automáticamente.
# Para probar por IP sin dominio, use DOMAIN=:80
DOMAIN=erp.midominio.com
PUBLIC_URL=https://erp.midominio.com

# Contraseña de la base de datos (larga y aleatoria)
DB_PASSWORD=cambiar-por-una-clave-larga

# Clave para firmar los tokens de sesión (larga y aleatoria; por ejemplo: openssl rand -base64 48)
JWT_SECRET=cambiar-por-otra-clave-larga

DEFAULT_MARGIN_PERCENT=20
